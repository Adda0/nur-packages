# The Build workflow is generated so the per-package build matrix cannot drift from the flake's
# package set: adding a package adds its matrix job.
{
  perSystem =
    {
      config,
      lib,
      ...
    }:
    let
      packageNames = lib.attrNames (lib.filterAttrs (_: lib.isDerivation) config.legacyPackages);
      # Every generated file has a `files/<name>` check, so `nix flake check` fails when a workflow or
      # the README drifts from the modules. `.envrc` is generated by sini/files itself (`generateApp`),
      # not by a `file` entry here. Attr names with a slash need the inner quotes.
      checkedFiles = [
        ".envrc"
        "README.md"
        ".github/workflows/build.yml"
      ];
      staticChecks = map (n: "files/${n}") checkedFiles ++ [
        "treefmt"
        "check-flake-file"
      ];
      # One job per package: a slow build then costs only its own runner, instead of serializing
      # after every other package in a single `nix flake check`.
      matrixItems = "\n          " + lib.concatMapStringsSep "\n          " (p: "- ${p}") packageNames;
      staticCheckArgs = lib.concatMapStringsSep " \\\n            " (
        c: "'.#checks.x86_64-linux.\"${c}\"'"
      ) staticChecks;
    in
    {
      files.file.".github/workflows/build.yml".text = ''
        # DO-NOT-EDIT. This file was auto-generated. Use `just generate` to regenerate it.
        name: Build
        on:
          pull_request:
          push:
            branches: [main]
          schedule:
            # Weekly probe of the moving nixos-unstable tree used by the NUR evaluation.
            - cron: "37 4 * * 1"
          workflow_dispatch:

        jobs:
          eval:
            runs-on: ubuntu-latest
            steps:
              - uses: actions/checkout@v7
              - uses: cachix/install-nix-action@v31
                with:
                  nix_path: nixpkgs=https://github.com/NixOS/nixpkgs/archive/refs/heads/nixos-unstable.tar.gz
                  extra_nix_config: |
                    access-tokens = github.com=''${{ secrets.GITHUB_TOKEN }}
              # The same evaluation NUR runs (ci/nur/eval.py), against nixos-unstable.
              - name: NUR evaluation check
                run: |
                  nix-env -f . -qa \* --meta --xml \
                    --allowed-uris https://static.rust-lang.org \
                    --option restrict-eval true \
                    --option allow-import-from-derivation true \
                    --drv-path --show-trace \
                    -I "nixpkgs=$(nix-instantiate --find-file nixpkgs)" \
                    -I "$PWD" > /dev/null

          # The checks that are not per-package builds: formatting, the generated-file freshness
          # checks, and the flake-files consistency check.
          static:
            needs: eval
            # Locked flake.nix: scheduled runs only probe moving NUR nixpkgs.
            if: github.event_name != 'schedule'
            runs-on: ubuntu-latest
            steps:
              - uses: actions/checkout@v7
              - uses: cachix/install-nix-action@v31
                with:
                  extra_nix_config: |
                    access-tokens = github.com=''${{ secrets.GITHUB_TOKEN }}
              - name: Formatting and generated files
                run: |
                  nix build --print-build-logs ${staticCheckArgs}

          build:
            needs: eval
            # Locked flake.nix: scheduled runs only probe moving NUR nixpkgs.
            if: github.event_name != 'schedule'
            runs-on: ubuntu-latest
            strategy:
              fail-fast: false
              matrix:
                package:${matrixItems}
            steps:
              - uses: actions/checkout@v7
              - uses: cachix/install-nix-action@v31
                with:
                  extra_nix_config: |
                    access-tokens = github.com=''${{ secrets.GITHUB_TOKEN }}
              - name: Build
                run: nix build --print-build-logs --no-link '.#checks.x86_64-linux.''${{ matrix.package }}'

          nur-update:
            needs: [static, build]
            if: github.event_name == 'push'
            runs-on: ubuntu-latest
            steps:
              - name: Trigger NUR update
                run: curl --fail --request POST "https://nur-update.nix-community.org/update?repo=adda"
      '';
    };
}
